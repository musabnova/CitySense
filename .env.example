# CitySense Core Environment Configuration
PROJECT_NAME="CitySense"
ENV=development
API_PORT=8000
API_HOST=0.0.0.0

# Database Persistence (PostgreSQL 16 + PostGIS + pgvector)
# For local fallback when docker is offline, sqlite+aiosqlite:///./citysense.db is automatically supported
DATABASE_URL=postgresql+asyncpg://citysense:citysense_pass@localhost:5432/citysense_db
DATABASE_URL_SYNC=postgresql://citysense:citysense_pass@localhost:5432/citysense_db

# Message Broker & Task Queue (Redis 7)
REDIS_URL=redis://localhost:6379/0

# Object Storage (S3 / Cloudflare R2) - Demo / Local Mode
STORAGE_ENDPOINT=
STORAGE_BUCKET_NAME=citysense-evidence
STORAGE_ACCESS_KEY=mock-access-key
STORAGE_SECRET_KEY=mock-secret-key

# AI Inference & Embeddings
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
EMBEDDING_DIM=768
LLM_PROVIDER=mock_deterministic
LLM_API_KEY=

# Security & Tokens
JWT_SECRET=citysense-dev-secret-key-change-in-production-98e508b3
TRACKING_SALT=citysense-tracking-salt

# Frontend Client Public Config
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

